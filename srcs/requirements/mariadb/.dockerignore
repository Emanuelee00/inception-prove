# Ignore secrets and local configuration files
../../secrets
../../.env

# Ignore temporary and log files
*.log
*.tmp
*~
__pycache__/
*.pyc
*.pyo
*.swp

# Ignore folders not required for the container build
# Only include conf/ and tools/ if they are copied in the Dockerfile
# If conf/ and tools/ are needed for the image, do NOT ignore them
#conf/
